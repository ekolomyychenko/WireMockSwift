# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode
xcuserdata/
*.xcodeproj
*.xcresult

# macOS
.DS_Store

# Stray WireMock runtime dirs (created if a server is launched from the package dir)
/mappings/
/__files/

# WireMock standalone server artifacts (downloaded/created by Scripts/start-wiremock.sh)
wiremock-standalone-*.jar
.wiremock*.pid
wiremock-*.log

# muter artifacts (Scripts/mutation.sh): the runtime-generated v16 config and logs.
# The canonical config is the committed dotted .muter.conf.yml.
/muter.conf.yml
/muter_logs/
